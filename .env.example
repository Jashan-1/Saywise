# Process env only: how SaySo runs. Client behavior lives in scope settings (ARCHITECTURE §6).

# Local: the compose Postgres (or any local Postgres) on 5433.
# Supabase: use the *session* pooler (port 5432) or the direct connection, with the
# postgresql+asyncpg:// scheme. The transaction pooler (port 6543) breaks LISTEN/NOTIFY
# and asyncpg prepared statements.
SAYSO_DATABASE_URL=postgresql+asyncpg://sayso:sayso@localhost:5433/sayso
SAYSO_PUBLIC_BASE_URL=http://localhost:8000
# At least 32 characters. Generate one with: openssl rand -hex 32
SAYSO_SIGNING_SECRET=change-me-to-a-random-secret-of-32-plus-chars
SAYSO_TWILIO_ACCOUNT_SID=
SAYSO_TWILIO_AUTH_TOKEN=
SAYSO_TWILIO_FROM_NUMBER=
SAYSO_AI_PROVIDER=anthropic
SAYSO_AI_MODEL=
SAYSO_AI_API_KEY=
SAYSO_LOG_LEVEL=INFO
# Email for approvers (asks and notifications). Port 587 + starttls, or 465 + ssl.
SAYSO_SMTP_HOST=
SAYSO_SMTP_PORT=587
SAYSO_SMTP_SECURITY=starttls
SAYSO_SMTP_USERNAME=
SAYSO_SMTP_PASSWORD=
SAYSO_SMTP_FROM=

# Tests use their own database and never read SAYSO_DATABASE_URL. The name must end in _test.
# SAYSO_TEST_DATABASE_URL=postgresql+asyncpg://sayso:sayso@localhost:5433/sayso_test
